// Set geometry for the city of San Francisco
var sf = ee.FeatureCollection("TIGER/2018/Counties") // city and county of SF have same spatial extent
            .filter(ee.Filter.eq('NAME', 'San Francisco')); 

// Filter out Farallon Islands from sf geometry
var sfMainland = sf.geometry().dissolve().buffer(-1000).buffer(1000); //do not want to include offshore islands in estimate
            
// Load NAIP imagery for 2022 and clip to study area
var naip2022 = ee.ImageCollection('USDA/NAIP/DOQQ')
  .filterBounds(sfMainland)
  .filterDate('2022-05-01', '2022-09-30')  // NAIP 2022 season
  .mosaic()  // combine into one image
  .clip(sfMainland); // clip to San Francisco

// // Check available bands (NAIP is usually: R, G, B, NIR)
// print('NAIP 2022 bands:', naip2022.bandNames());

// Add to map
Map.centerObject(sfMainland, 12);
Map.addLayer(naip2022, {bands: ['R', 'G', 'B'], min: 0, max: 255}, 'NAIP 2022 RGB');

// Calculate NDVI: (NIR - Red) / (NIR + Red)
// NAIP band names: ['R', 'G', 'B', 'N']
var ndvi = naip2022.normalizedDifference(['N', 'R']).multiply(1000).toInt().rename('NDVI');

// Add NDVI 2022 to map
Map.addLayer(ndvi, {min: 0, max: 1000, palette: ['white', 'green']}, 'NDVI Raw 2022');

// Load Canopy Height Model (CHM) derived from San Francisco LiDAR 2023 dataset
var chm = ee.Image("projects/ee-harpecas/assets/CHM_SF_2m")
             .clip(sfMainland);
             
// Convert CHM into classes (1: <1 ft, 2: 1–8 ft, 3: >8 ft) //actual code in meters
var class1 = chm.lt(0.3); // <1 foot
var class2 = chm.gte(0.3).and(chm.lte(2.438)); // 1–8 feet
var class3 = chm.gt(2.438); // >8 feet

// Combine into one image with values 1, 2, or 3
var chmClassified = class1.multiply(1)
                     .add(class2.multiply(2))
                     .add(class3.multiply(3))
                     .rename('CHM_Class');

// Define a color palette for visualization
var palette = ['gray', 'yellow', 'green']; // class 1 = gray, 2 = yellow, 3 = green

Map.addLayer(chmClassified, {min: 1, max: 3, palette: palette}, 'CHM Height Classes');

// Reclassify NDVI into binary categories

// NDVI classification 200 selected as vegetation threshold
var ndviClass = ndvi.gt(0.2).rename('VegetationMask');  // 1 = vegetation, 0 = non-vegetation

// Visualization
Map.addLayer(ndviClass.updateMask(ndviClass), {palette: ['green']}, 'NDVI > 200 (Vegetation)');
Map.addLayer(ndviClass.updateMask(ndviClass.not()), {palette: ['gray']}, 'NDVI ≤ 200 (Non-Vegetation)');

// Define CHM height threshold for trees (>8 ft = 2.4 meters)
var isTall = chm.gt(2.4); // to eliminate "field goal effect", tall sports equip. in green fields returning FPs

// Define NDVI threshold for vegetation (>200)
var isVegetation = ndvi.gt(200);

// Combine both: NDVI > 200 AND CHM > 8 ft
var treeCanopyMask = isVegetation.and(isTall);

// Convert mask into binary band
// treeCanopyBinary is a binary raster (1 = tree, 0 or masked = no tree)
var treeCanopyBinary = treeCanopyMask
  .unmask(0)       // fill in non-canopy areas with 0
  .rename('prediction');

// Apply mask to NDVI
var treeCanopyNDVI = ndvi.updateMask(treeCanopyMask);

// Visualize
Map.addLayer(treeCanopyNDVI, {min: 0, max: 1, palette: ['white', 'green']}, 'High-Confidence Tree Canopy');

