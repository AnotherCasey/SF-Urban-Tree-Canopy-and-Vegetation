// Calculate Urban Tree Canopy estimate
// 1. Image of pixel area in m², masked to tree canopy only
var pixelArea = ee.Image.pixelArea().updateMask(treeCanopyMask);

// 2. Total tree canopy area in m² over SF mainland
var canopyArea_m2 = pixelArea.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: sfMainland,
  scale: 1,  // match CHM/NAIP resolution
  maxPixels: 1e10
});

// 3. Convert to acres (1 acre = 4046.8564224 m²)
var canopyArea_acres = ee.Number(canopyArea_m2.get('area')).divide(4046.8564224);

print('Urban Tree Canopy Area (m²):', canopyArea_m2.get('area'));
print('Urban Tree Canopy Area (acres):', canopyArea_acres);


